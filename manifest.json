            "123456",
            "test@example.com"
          ],
          "description": "需要输入的文本内容"
        },
        {
          "name": "clear_before",
          "display_name": "输入前清空内容",
          "intrinsic_type": "boolean",
          "default_type": "boolean",
          "default_value": "false",
          "presets": [
            "true",
            "false"
          ],
          "description": "若为 true，则在输入新文本前自动模拟退格删除已有内容"
        }
