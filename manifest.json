{
  "plugin_id": "xy_mobile",
  "name": "手机与安卓模拟器 (Mobile & Emulator)",
  "version": "0.51.0",
  "group": "Mobile",
  "group_icon": "📱",
  "description": "提供连接雷电/MuMu等模拟器与真机、屏幕点击、滑动翻页、文字输入、极速截屏与 App 安装管理等功能",
  "actions": [
    {
      "tag": "MobileDevices",
      "display_name": "获取移动设备与模拟器列表 (Get Devices)",
      "icon": "📱",
      "platforms": "Android / iOS",
      "description": "自动扫描并连接电脑上打开的安卓模拟器（雷电/MuMu/夜神/AVD）或真机设备",
      "keywords": [
        "devices",
        "emulator",
        "adb",
        "simctl",
        "模拟器",
        "设备列表",
        "发现设备",
        "mumu",
        "雷电",
        "夜神",
        "android",
        "ios"
      ],
      "fields": [
        {
          "name": "auto_connect",
          "display_name": "自动扫描并连接模拟器端口",
          "intrinsic_type": "boolean",
          "default_type": "boolean",
          "default_value": "true",
          "presets": [
            "true",
            "false"
          ],
          "description": "是否自动对 MuMu (16384/7555)、雷电 (5555/5557)、夜神 (62001)、逍遥 (21503) 等已知模拟器端口发起健康探测与连接"
        },
        {
          "name": "output_alias",
          "display_name": "输出变量名",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "mobile_devices",
          "presets": [
            "mobile_devices"
          ],
          "description": "存储发现设备 JSON 数组的上下文变量名"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "MobileTap",
      "display_name": "屏幕点击 (Mobile Tap)",
      "icon": "👆",
      "platforms": "Android / iOS",
      "description": "在手机或模拟器屏幕的指定位置模拟手指点击或双击",
      "keywords": [
        "tap",
        "click",
        "touch",
        "点击",
        "触控",
        "按压",
        "android",
        "ios",
        "模拟器"
      ],
      "fields": [
        {
          "name": "device",
          "display_name": "目标设备 (Device Serial)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "auto",
          "presets": [
            "auto",
            "127.0.0.1:16384 (MuMu)",
            "127.0.0.1:5555 (雷电)",
            "emulator-5554 (AVD)",
            "booted (iOS)"
          ],
          "description": "目标设备唯一标识或模拟器 ADB 端口。填写 'auto' 将自动选择首个在线活跃设备；iOS 可填写 'booted' 匹配当前运行中的模拟器"
        },
        {
          "name": "xy",
          "display_name": "点击坐标 (X, Y)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "500, 500",
          "presets": [
            "500, 500",
            "100, 200",
            "540, 960",
            "300, 600"
          ],
          "description": "触摸屏幕的像素绝对坐标，格式为 'X, Y'（如 '540, 960'）"
        },
        {
          "name": "count",
          "display_name": "点击次数",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "1",
          "presets": [
            "1",
            "2"
          ],
          "description": "连续点击次数，默认为 1（单击），设置为 2 时执行双击"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "MobileSwipe",
      "display_name": "滑动与拖拽 (Mobile Swipe)",
      "icon": "👉",
      "platforms": "Android / iOS",
      "description": "在手机屏幕上模拟手指向上、下、左、右滑动翻页或长按拖拽",
      "keywords": [
        "swipe",
        "drag",
        "scroll",
        "滑动",
        "拖拽",
        "翻页",
        "刷新",
        "android",
        "ios"
      ],
      "fields": [
        {
          "name": "device",
          "display_name": "目标设备",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "auto",
          "presets": [
            "auto",
            "127.0.0.1:16384",
            "booted"
          ],
          "description": "目标设备序列号或模拟器端口"
        },
        {
          "name": "from_xy",
          "display_name": "起始坐标 (X1, Y1)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "500, 800",
          "presets": [
            "500, 800 (上滑起点)",
            "500, 200 (下滑起点)",
            "800, 500 (左滑起点)"
          ],
          "description": "滑动起始点像素坐标，格式为 'X, Y'"
        },
        {
          "name": "to_xy",
          "display_name": "终止坐标 (X2, Y2)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "500, 200",
          "presets": [
            "500, 200 (上滑终点)",
            "500, 800 (下滑终点)",
            "200, 500 (左滑终点)"
          ],
          "description": "滑动终点像素坐标，格式为 'X, Y'"
        },
        {
          "name": "duration_ms",
          "display_name": "滑动耗时 (毫秒)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "300",
          "presets": [
            "200",
            "300",
            "500",
            "1000"
          ],
          "description": "从起点移动到终点所经历的手势持续时间（毫秒），耗时越长越接近慢速拖拽"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "MobileInput",
      "display_name": "文本输入 (Mobile Input Text)",
      "icon": "⌨️",
      "platforms": "Android / iOS",
      "description": "向手机或模拟器当前选中的输入框输入一段文字",
